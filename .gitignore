# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 数据库只在本地，不入库（含个人分销数据）：WAL/SHM、爬虫日志、.DS_Store 一并忽略
/data/
/public/uploads/

# 小程序解包产物与一次性探活脚本
/reference/wxapkg-jtc/
/reference/probe*.sh

# 本地调试产物
/.playwright-mcp/

# 小工具构建产物（由 scripts/build-minitool.mjs 从 minitool/src + data/jtc.db 生成）
/minitool/dist/
