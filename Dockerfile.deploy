# 本地发版用的运行时镜像。
#
# 为什么和根目录的 Dockerfile 分开：
#   根 Dockerfile 是「CI 里从源码构建」（npm ci + next build），那是跨境链路时代
#   为了不占服务器 CPU 才这么做的，结果卡在 30KB/s 的跨境上行上走不通。
#   现在改成「Mac 上构建 → rsync 产物 → 服务器只 COPY」，服务器侧不需要 Node 构建工具链，
#   这个文件就是服务器上真正用的那个：产物已经在 rsync 过来的目录里了。
#
# 构建上下文 = 产物目录（standalone + .next/static），本文件由 scripts/deploy.sh 放进去。
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

COPY --chown=nextjs:nodejs . ./

# 上传文件落在 public/uploads，运行时由站点目录的 data/uploads 挂卷覆盖
# /app/data 放 SQLite 业务库，运行时由站点目录的 data 挂卷覆盖
RUN mkdir -p /app/public/uploads /app/data && chown -R nextjs:nodejs /app/public/uploads /app/data

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
